# Auto-generated by bird-interact-cloud — do not edit by hand.
# Render inputs are stored in `runs/{{ run_id }}/manifest.json:render_inputs`
# so `kill`/`resubmit` can re-render from GCS on any machine.

cluster_name: {{ run_id }}

provider:
  type: gcp
  region: {{ region }}
  availability_zone: {{ zone }}
  project_id: {{ project }}

auth:
  ssh_user: ubuntu
  # Pin our own keypair so Ray never auto-generates (which corrupts the
  # keypair across `ray up`/`ray exec`). The matching public key is
  # pushed to each VM via instance metadata below.
  ssh_private_key: {{ ssh_private_key }}

max_workers: {{ workers }}
upscaling_speed: 0
idle_timeout_minutes: 30

docker:
  image: {{ image_uri }}
  container_name: bird_interact_cloud
  pull_before_run: True
  run_options:
    # De-bake (this chunk): BIRD_DB_PATH/BIRD_DATA_PATH are NO LONGER pinned to
    # /data/mini-interact here. The benchmark dataset is downloaded from GCS per
    # node into the benchmark's container_data_dir (/data/<benchmark>) and the
    # actor sets the benchmark's data-root/data-file env vars to it at runtime,
    # so one image+cluster serves any benchmark.
    - "--env BIRD_RESULTS_ROOT=/tmp/results"
    - "--env BIRD_INTERACT_AGENTS_CLOUD=1"
    # DEV-1468: the actor downloads the uploaded slayer setup into these roots
    # (paths.*_root() honour them), so the in-cluster per-task storage builders
    # find the artifacts exactly where the local path looks.
    - "--env BIRD_SLAYER_MODELS_ROOT=/data/slayer_models"
    - "--env BIRD_OTF_CACHE_ROOT=/data/slayer_otf_cache"
    - "--env BIRD_SLAYER_MODELS_OTF_ROOT=/data/slayer_models_otf"

available_node_types:
  ray-head-default:
    node_config:
      # e2-medium (4GB) not e2-small (2GB): the head runs Ray's GCS,
      # dashboard, autoscaler AND the in-cluster job driver (ray_app),
      # which together exceed 2GB and OOM.
      machineType: e2-medium
      serviceAccounts:
        - email: {{ worker_sa }}
          scopes:
            - "https://www.googleapis.com/auth/cloud-platform"
      metadata:
        items:
          - key: ssh-keys
            value: "ubuntu:{{ ssh_public_key }}"
          - key: enable-oslogin
            value: "FALSE"
      labels:
        bird-interact-run-id: {{ run_id }}
        bird-interact-image-tag: "{{ run_id }}"
      disks:
        - boot: true
          autoDelete: true
          type: PERSISTENT
          initializeParams:
            diskSizeGb: 50
            sourceImage: projects/ubuntu-os-cloud/global/images/family/ubuntu-2204-lts
    # CPU: 0 makes the head coordination-only — Ray won't schedule
    # WorkerActors here, so they wait for (and land on) the e2-standard-4
    # workers with 16GB. Without this, an actor lands on the tiny head and
    # is OOM-killed during __init__.
    resources:
      CPU: 0
    min_workers: 0
    max_workers: 0
  ray-worker-default:
    node_config:
      machineType: {{ worker_type }}
      serviceAccounts:
        - email: {{ worker_sa }}
          scopes:
            - "https://www.googleapis.com/auth/cloud-platform"
      metadata:
        items:
          - key: ssh-keys
            value: "ubuntu:{{ ssh_public_key }}"
          - key: enable-oslogin
            value: "FALSE"
      labels:
        bird-interact-run-id: {{ run_id }}
        bird-interact-image-tag: "{{ run_id }}"
      disks:
        - boot: true
          autoDelete: true
          type: PERSISTENT
          initializeParams:
            diskSizeGb: 50
            sourceImage: projects/ubuntu-os-cloud/global/images/family/ubuntu-2204-lts
    resources:
      CPU: {{ actors_per_worker }}
    min_workers: {{ workers }}
    max_workers: {{ workers }}

head_node_type: ray-head-default

initialization_commands:
  # 1. Install Docker + rsync. Ubuntu 22.04 minimal images don't ship
  #    either; Ray needs docker to pull the runner image AND uses rsync
  #    (via `docker exec`) to mount bootstrap files into the container.
  - >
    if ! command -v docker >/dev/null 2>&1; then
      curl -fsSL https://get.docker.com | sudo sh &&
      sudo systemctl enable --now docker;
    fi
  - sudo apt-get -qq update && sudo apt-get -qq install -y rsync
  # 2. Hand docker.sock to the SSH-invoking `ubuntu` user so it can run
  #    `docker pull` immediately — `usermod -aG docker ubuntu` wouldn't take
  #    effect until next SSH login, but Ray needs to pull inside the SAME
  #    session that finished installing docker. `chown ubuntu` (not
  #    `chmod 666`) keeps the socket from being world-writable, which would
  #    let any local user on the VM drive the Docker daemon as root.
  - sudo chown ubuntu /var/run/docker.sock
  # 3. Install gcloud (Ubuntu 22.04 doesn't ship it) — needed both for the
  #    docker credential helper that authenticates pulls from
  #    `{{ region }}-docker.pkg.dev`, AND for the self-delete safety timer.
  - >
    if ! command -v gcloud >/dev/null 2>&1; then
      sudo snap install google-cloud-cli --classic;
    fi
  # 4. Wire gcloud into docker's credential helpers for our AR region so
  #    `docker pull <our-image>` authenticates as the VM's service
  #    account via the metadata server.
  - gcloud --quiet auth configure-docker {{ region }}-docker.pkg.dev
  # 5. VM self-delete safety timer — deletes the instance + boot disk
  #    after the timer, so the cluster is fully removed even if the
  #    laptop driver never tears it down.
  - >
    nohup bash -c "sleep {{ max_runtime_seconds }} &&
    gcloud --quiet compute instances delete \"$(hostname)\"
    --zone={{ zone }} --delete-disks=all" >/tmp/self_delete.log 2>&1 &

setup_commands: []
head_setup_commands: []
worker_setup_commands: []

head_start_ray_commands:
  - ray stop
  - ulimit -n 65536; ray start --head --port=6379 --object-manager-port=8076 --autoscaling-config=~/ray_bootstrap_config.yaml

worker_start_ray_commands:
  - ray stop
  - ulimit -n 65536; ray start --address=$RAY_HEAD_IP:6379 --object-manager-port=8076
